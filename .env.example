# ─────────────────────────────────────────────────────────────
#  AI 프로바이더 — 기본값은 config/ai.ts 의 ACTIVE_PROVIDER (현재 bedrock)
#  아래 두 값은 config/ai.ts 를 덮어쓸 때만 지정
# ─────────────────────────────────────────────────────────────
# AI_PROVIDER=bedrock          # bedrock | google  (openai, anthropic 은 config/ai.ts 에서 주석 해제 후 사용)
AI_MODEL=us.anthropic.claude-sonnet-5   # 텍스트 톡 모델. 비우면 config/ai.ts 기본값(Claude Sonnet 5). 지금 쓰는 모델 확인: /api/status

# Amazon Bedrock (활성)
AWS_BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1       # 권장: Vercel 은 AWS_REGION 을 함수 리전으로 자동 주입할 수 있음
# AWS_REGION=us-east-1         # BEDROCK_REGION 이 없을 때 사용
# BEDROCK_USE_IAM=true         # API 키 대신 IAM 액세스 키를 쓸 때만 (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY 필요)

# Google Gemini — ⚠️ 지우거나 주석 처리하지 마세요: 보이스톡·실시간 사진·목소리 미리 듣기가 이 키로 동작합니다
#   (AI_PROVIDER=google 로 바꾸면 텍스트 톡도 Gemini 로 전환)
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI / Anthropic (비활성 — config/ai.ts 주석 해제 시)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# (선택) 프록시/게이트웨이
# BEDROCK_BASE_URL=
# GOOGLE_GENERATIVE_AI_BASE_URL=

# ─────────────────────────────────────────────────────────────
#  보이스톡 (AI 음성 통화, docs/VOICE_TALK.md) — GOOGLE_GENERATIVE_AI_API_KEY 필요
# ─────────────────────────────────────────────────────────────
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview   # 또는 gemini-3.8-live
# VOICE_ACCESS=open        # open | paid | off   (기본: 개발 open, 배포 paid)
# VOICE_DEV_PASS=          # 결제 연동 전 배포 환경 테스트용 암호
# VOICE_MAX_MINUTES=10     # 통화 1회 최대 길이(분, 최대 10)

# 유료 리액션 영상 (clips/premium/, docs/REACTION_VIDEOS.md) — 바꾸면 Redeploy 필요
# PREMIUM_ACCESS=open      # open | paid   (기본: 개발 open, 배포 paid)

# 사진 보내기 — 유료 실시간 사진 (docs/MEDIA.md)
# MEDIA_ACCESS=open        # open | paid | off   (기본: 개발 open, 배포 paid)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ─────────────────────────────────────────────────────────────
#  아바타
# ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_AVATAR_MODE=video   # video | 3d   (docs/VIDEO_AVATAR.md)
# NEXT_PUBLIC_AVATAR_CLIP_EXT=mp4
# NEXT_PUBLIC_AVATAR_MODEL_URL=/models/avatar.glb   # 3d 모드 (docs/AVATAR_SETUP.md)

# 목소리 미리 듣기(/voice-lab)용 TTS 모델 (선택, 기본 gemini-3.8-flash-lite-tts)
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
